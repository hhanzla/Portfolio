---
---

<!-- Crisp White Header Logo Badge -->
<div class="brand" id="brand-badge" style="color-scheme: only light !important;">
    <img src="/logo.png" alt="Hanzla Masood Logo" class="brand-logo-img" style="color-scheme: only light !important;" />
</div>

<nav class="navbar" id="floating-navbar" style="color-scheme: only light !important;">
    <ul>
        <li><button id="nav-btn-work" class="glitch-hover" data-text="WORK" style="color-scheme: only light !important; color: #111111 !important;">WORK</button></li>
        <li><button id="nav-btn-about" class="glitch-hover" data-text="ABOUT" style="color-scheme: only light !important; color: #111111 !important;">ABOUT</button></li>
        <li><button id="nav-btn-contact" class="glitch-hover" data-text="CONTACT" style="color-scheme: only light !important; color: #111111 !important;">CONTACT</button></li>
        <li><button id="nav-btn-cta" class="work-with-us glitch-hover" data-text="WORK WITH US" style="color-scheme: only light !important;">WORK WITH US</button></li>
    </ul>
</nav>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        function scrollToSection(sectionId) {
            const target = document.getElementById(sectionId);
            if (target) {
                if (window.lenis) {
                    window.lenis.scrollTo(target, { duration: 1.2, offset: 0 });
                } else {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        }

        const navAbout = document.getElementById('nav-btn-about');
        const navWork = document.getElementById('nav-btn-work');
        const navContact = document.getElementById('nav-btn-contact');
        const navCta = document.getElementById('nav-btn-cta');
        const brandBadge = document.getElementById('brand-badge');

        if (navAbout) navAbout.addEventListener('click', () => scrollToSection('about-section'));
        if (navWork) navWork.addEventListener('click', () => scrollToSection('work-section'));
        if (navContact) navContact.addEventListener('click', () => scrollToSection('contact-section'));
        if (navCta) navCta.addEventListener('click', () => scrollToSection('contact-section'));
        if (brandBadge) brandBadge.addEventListener('click', () => scrollToSection('hero-section'));

        // Draggable Navbar
        const navbar = document.getElementById('floating-navbar');
        let isDragging = false;
        let startX, startY, startLeft, startTop;

        if (navbar) {
            navbar.addEventListener('mousedown', (e) => {
                if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
                startX = e.clientX;
                startY = e.clientY;
                const rect = navbar.getBoundingClientRect();
                startLeft = rect.left;
                startTop = rect.top;
                isDragging = true;
                navbar.style.cursor = 'grabbing';
            });

            document.addEventListener('mousemove', (e) => {
                if (!isDragging || !navbar) return;
                let newLeft = startLeft + (e.clientX - startX);
                let newTop = startTop + (e.clientY - startY);
                newLeft = Math.max(0, Math.min(newLeft, window.innerWidth - navbar.offsetWidth));
                newTop = Math.max(0, Math.min(newTop, window.innerHeight - navbar.offsetHeight));
                navbar.style.left = newLeft + 'px';
                navbar.style.top = newTop + 'px';
            });

            document.addEventListener('mouseup', () => {
                if (!isDragging) return;
                isDragging = false;
                if (navbar) navbar.style.cursor = 'grab';
            });
        }
        // Glitch / Scramble Text Hover Effect
        const glitchChars = '!@#$%^&*()_+-=[]{}|;:,.<>?/~`01';
        const glitchBtns = document.querySelectorAll('.glitch-hover');

        glitchBtns.forEach(btn => {
            let isAnimating = false;

            btn.addEventListener('mouseenter', () => {
                if (isAnimating) return;
                isAnimating = true;

                // Lock button width so glitch chars don't resize navbar
                const currentWidth = btn.offsetWidth;
                btn.style.minWidth = currentWidth + 'px';
                btn.style.maxWidth = currentWidth + 'px';

                const originalText = btn.getAttribute('data-text') || btn.textContent;
                const length = originalText.length;
                const totalDuration = 400; // ms
                const iterations = 6;
                const intervalTime = totalDuration / (length * iterations);
                let resolved = 0;

                const interval = setInterval(() => {
                    let display = '';
                    for (let i = 0; i < length; i++) {
                        if (i < resolved) {
                            display += originalText[i];
                        } else if (originalText[i] === ' ') {
                            display += ' ';
                        } else {
                            display += glitchChars[Math.floor(Math.random() * glitchChars.length)];
                        }
                    }
                    btn.textContent = display;

                    // Resolve one more character every few iterations
                    if (Math.random() > 0.5 && resolved < length) {
                        resolved++;
                    }

                    if (resolved >= length) {
                        clearInterval(interval);
                        btn.textContent = originalText;
                        isAnimating = false;
                    }
                }, intervalTime);
            });
        });
    });
</script>
