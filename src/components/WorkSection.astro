---
import WorkCard from './WorkCard.astro';
import imgQwisync from '../assets/images/Qwisync.png';
import imgMyFastMovers from '../assets/images/MyFastMovers.com.png';
import imgBaltonics from '../assets/images/baltonics.com.png';
import imgThindNotary from '../assets/images/ThindNotary.com.png';
import imgInnova8ify from '../assets/images/innova8ifyllc.com.png';
import imgNexoraCodes from '../assets/images/NexoraCodes.com.png';

const projects = [
  {
    num: "01",
    title: "QwiSync",
    description: "Premier digital agency platform serving client ecosystems across Pak & US. Features high-performance scroll animations, light strip FX, interactive scramblers, and a modular service showcase.",
    badge: "QwiSync — Digital Agency",
    tag: "Astro.js / Tailwind CSS / GSAP",
    isReversed: false,
    image: imgQwisync,
    link: "https://qwisync-v2.pages.dev/"
  },
  {
    num: "02",
    title: "My Fast Movers",
    description: "Comprehensive long-distance moving platform built for nationwide US logistics. Integrates state-by-state cost calculators, interactive route finders, and real-time moving cost estimators.",
    badge: "My Fast Movers",
    tag: "Astro.js / Tailwind CSS / SEO",
    isReversed: true,
    image: imgMyFastMovers,
    link: "https://www.myfastmovers.com/"
  },
  {
    num: "03",
    title: "Baltonics",
    description: "Modern e-commerce platform for Crown Hair Tonic featuring custom product landing pages, WhatsApp order integration, responsive checkout flows, and high-conversion UI design.",
    badge: "Baltonics — E-Commerce Platform",
    tag: "Next.js / React / Tailwind CSS",
    isReversed: false,
    image: imgBaltonics,
    link: "https://baltonics.com/"
  },
  {
    num: "04",
    title: "Thind Notary Public",
    description: "Certified notarial services platform built for Sharan Thind Notary Public in Surrey, BC. Handles real estate document notarization, wills, powers of attorney, and online appointment booking.",
    badge: "Thind Notary — Surrey, BC",
    tag: "HTML / CSS / JS / SEO",
    isReversed: true,
    image: imgThindNotary,
    link: "https://thindnotary.com/"
  },
  {
    num: "05",
    title: "Innova8ify LLC",
    description: "Modern digital marketing agency platform featuring custom UI components, responsive layout systems, Swiper carousel integrations, and tailored digital strategy services.",
    badge: "Innova8ify — Digital Marketing",
    tag: "HTML5 / Tailwind CSS / JS",
    isReversed: false,
    image: imgInnova8ify,
    link: "https://innova8ifyllc.com/"
  },
  {
    num: "06",
    title: "Nexora Codes",
    description: "Premier software development agency specializing in custom web applications, mobile apps, UI/UX design, and scalable enterprise software solutions for global brands.",
    badge: "Nexora Codes — Software Agency",
    tag: "Next.js / React / Node.js",
    isReversed: true,
    image: imgNexoraCodes,
    link: "https://www.nexoracodes.com/"
  }
];
---

<section id="work-section" class="portfolio-section">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">01 / FEATURED PROJECTS</span>
            <h2 class="section-title work-title">Selected Works</h2>
            <p class="section-disclaimer-text">
                <span class="disclaimer-icon">🛡️</span> All featured client projects are open-sourced and showcased with explicit permission from the respective business owners.
            </p>
        </div>

        <div class="work-grid-container">
            {projects.map((project, index) => (
                <WorkCard {...project} index={index} />
            ))}
        </div>

        <!-- See more link -->
        <div class="work-more" style="margin-top: 3rem; text-align: center;">
            <a href="https://github.com/hhanzla" target="_blank" class="work-more-link">
                See other public repositories &rarr;
            </a>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.work-grid-card');
        const container = document.querySelector('.work-grid-container');
        if (!cards.length || !container) return;

        function updateCardStack() {
            const currentScroll = window.lenis ? window.lenis.scroll : window.scrollY;
            const containerTop = container.getBoundingClientRect().top + currentScroll;
            const viewportH = window.innerHeight || 800;

            cards.forEach((card, index) => {
                const stickyTop = 85 + index * 24;
                const cardDocTop = containerTop + card.offsetTop;
                const stickScrollY = cardDocTop - stickyTop;

                if (currentScroll > stickScrollY) {
                    const scrollDistance = currentScroll - stickScrollY;
                    const progress = Math.min(1, Math.max(0, scrollDistance / (viewportH * 0.6)));
                    const scale = 1 - (progress * 0.08);
                    card.style.transform = `translate3d(0, 0, 0) scale(${scale})`;
                } else {
                    card.style.transform = 'translate3d(0, 0, 0) scale(1)';
                }
            });
        }

        if (window.lenis) {
            window.lenis.on('scroll', updateCardStack);
        } else {
            window.addEventListener('scroll', updateCardStack, { passive: true });
        }
        updateCardStack();
        window.addEventListener('resize', updateCardStack);
    });
</script>
