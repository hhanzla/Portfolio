---
---

<div class="hero" id="hero-section">
    <!-- Ambient Cyber Neon Strip Lights Background -->
    <div class="bg-neon-strips" aria-hidden="true">
        <div class="neon-strip strip-1"></div>
        <div class="neon-strip strip-2"></div>
        <div class="neon-strip strip-3"></div>
        <div class="neon-strip strip-4"></div>
    </div>

    <!-- Snowfall Effect -->
    <div class="hero-snow" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="hero-content">
        <h1 class="hero-title">BEYOND THE<br />BROWSER</h1>
        <p class="hero-subtitle">From responsive web apps to native desktop experiences.</p>
    </div>

    <!-- Bottom Left Text -->
    <div class="hero-bottom-left">
        <p id="hero-est-text">EST. 2026</p>
        <p id="hero-based-text" style="margin-top: 5px;">BASED IN PAKISTAN</p>
    </div>

    <!-- Bottom Right Split Diagonal Button -->
    <div class="hero-btn-container" id="hero-discover-btn">
        <button class="hero-diagonal-main"><span>EXPLORE WORK</span></button>
        <button class="hero-diagonal-arrow">
            <span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </span>
        </button>
    </div>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const heroEl = document.querySelector('.hero');
        const heroContent = document.querySelector('.hero-content');
        const heroBottomLeft = document.querySelector('.hero-bottom-left');
        const heroBtnContainer = document.querySelector('.hero-btn-container');
        const brandBadge = document.getElementById('brand-badge');
        const navbar = document.getElementById('floating-navbar');

        function updateHeroMorph(scrollY) {
            if (!heroEl) return;
            const maxScroll = window.innerHeight * 0.45;
            const rawProgress = Math.min(1, Math.max(0, scrollY / maxScroll));
            // Smooth quadratic ease-out curve for liquid expansion
            const progress = 1 - Math.pow(1 - rawProgress, 2);

            const inset = (1 - progress) * 8;
            const radius = (1 - progress) * 8;
            const contentOffset = progress * 8;

            heroEl.style.margin = `${inset}px auto`;
            heroEl.style.width = `calc(100% - ${inset * 2}px)`;
            heroEl.style.borderRadius = `${radius}px`;

            if (heroContent) {
                heroContent.style.paddingLeft = `${22 + contentOffset}px`;
                heroContent.style.paddingRight = `${22 + contentOffset}px`;
            }
            if (heroBottomLeft) {
                heroBottomLeft.style.left = `${22 + contentOffset}px`;
            }
            if (heroBtnContainer) {
                heroBtnContainer.style.right = `${22 + contentOffset}px`;
            }

            // Seamless 100% Unified Solid White Header (Zero Dividing Seam)
            if (brandBadge && navbar && window.innerWidth > 768) {
                const brandW = brandBadge.offsetWidth || 160;
                const navW = navbar.offsetWidth || 380;

                const initialBrandLeft = 30;
                const initialNavLeft = window.innerWidth - 30 - navW;

                // Gap shrinks to -1px to eliminate any pixel divide line
                const gap = (1 - progress) * 16 - progress * 1;
                const totalCombinedWidth = brandW + gap + navW;

                const centerLeft = (window.innerWidth - totalCombinedWidth) / 2;
                const targetBrandLeft = centerLeft;
                const targetNavLeft = centerLeft + brandW + gap;

                const brandDeltaX = (targetBrandLeft - initialBrandLeft) * progress;
                const navDeltaX = (targetNavLeft - initialNavLeft) * progress;

                brandBadge.style.transform = `translate3d(${brandDeltaX}px, 0, 0)`;
                navbar.style.transform = `translate3d(${navDeltaX}px, 0, 0)`;

                // Morph inner border-radii to 0px
                const innerRadius = (1 - progress) * 6;
                brandBadge.style.borderTopRightRadius = `${innerRadius}px`;
                brandBadge.style.borderBottomRightRadius = `${innerRadius}px`;

                navbar.style.borderTopLeftRadius = `${innerRadius}px`;
                navbar.style.borderBottomLeftRadius = `${innerRadius}px`;

                // Erase inner dividing borders and merge shadow into one outer shadow
                if (progress > 0.4) {
                    brandBadge.style.borderRight = 'none';
                    navbar.style.borderLeft = 'none';
                } else {
                    brandBadge.style.borderRight = '1px solid rgba(0, 0, 0, 0.12)';
                    navbar.style.borderLeft = '1px solid rgba(0, 0, 0, 0.12)';
                }

                if (progress > 0.8) {
                    brandBadge.style.boxShadow = 'none';
                    navbar.style.boxShadow = '0 4px 25px rgba(0, 0, 0, 0.18)';
                } else {
                    brandBadge.style.boxShadow = '0 4px 25px rgba(0, 0, 0, 0.18)';
                    navbar.style.boxShadow = '0 4px 25px rgba(0, 0, 0, 0.18)';
                }
            }
        }

        if (window.lenis) {
            window.lenis.on('scroll', (e) => updateHeroMorph(e.scroll));
        } else {
            window.addEventListener('scroll', () => updateHeroMorph(window.scrollY), { passive: true });
        }

        window.addEventListener('resize', () => {
            const scrollY = window.lenis ? window.lenis.scroll : window.scrollY;
            updateHeroMorph(scrollY || 0);
        });

        const discoverBtn = document.getElementById('hero-discover-btn');
        if (discoverBtn) {
            discoverBtn.addEventListener('click', () => {
                const target = document.getElementById('work-section');
                if (!target) return;

                const lenis = window.lenis;
                if (lenis) {
                    lenis.scrollTo(target, {
                        duration: 1.4,
                        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                        offset: 0
                    });
                } else {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }
    });
</script>
